# Telegram API credentials (required)
API_ID=12345678
API_HASH=replace_with_telegram_api_hash

# Pyrogram user sessions (A and B are required; C/D are optional)
SESSION_A_STRING=replace_with_session_a_string
SESSION_B_STRING=replace_with_session_b_string
# SESSION_C_STRING=
# SESSION_D_STRING=

# Owner and monitored chats (required)
OWNER_IDS=123456789
GROUP_IDS=-1001234567890
# LOG_GROUP_ID=-1001234567890

# Human-chat behavior
HUMAN_CHAT_SESSIONS=a,b,c,d
MIN_REPLY_DELAY=2
MAX_REPLY_DELAY=4
REPLY_CHANCE=0.25
LOOP_PAUSE_DELAY=0
OWNER_TAG=@Bikasec
DEBUG=false

# Auto-forward / auto-catch (disabled by default)
AUTO_FORWARD_ENABLED=false
AUTO_CATCH_SESSIONS=a,b
# Required when AUTO_FORWARD_ENABLED=true and DIRECT_DB_CATCH_ENABLED=false:
# BOT_ID=123456789
# RESPONDER_BOT_ID=123456789
# Or use RESPONDER_BOT_IDS=123456789,987654321

# Optional direct MongoDB lookup (disabled by default).
# The connection is used read-only by the bot.
DIRECT_DB_CATCH_ENABLED=false
DIRECT_DB_FALLBACK_TO_RESPONDER=false
# DIRECT_DB_MONGO_URI=mongodb+srv://...
# DIRECT_DB_NAME=your_database
# DIRECT_DB_COLLECTION=items
DIRECT_DB_CATCH_SESSIONS=a,b

# Captcha solver (disabled by default; manual approval is the safe default)
CAPTCHA_SOLVER_ENABLED=false
CAPTCHA_AUTO_APPROVE=false
CAPTCHA_SOLVER_SESSIONS=a,b
CAPTCHA_AUTO_APPROVE_MIN_CONFIDENCE=0.75
CAPTCHA_MIN_CONFIDENCE=0.60
MIN_SOLVER_CONFIDENCE=0.60
APPROVAL_TIMEOUT_SEC=120
CAPTCHA_SOLVER_CONCURRENCY=1
CAPTCHA_SOLVER_TIMEOUT_SECONDS=18
ENABLE_OCR_FALLBACK=true
CAPTCHA_LEARNING_ENABLED=true
ENABLE_TESSERACT_OCR=true
ENABLE_EASYOCR=false
CAPTCHA_ALLOW_COORDINATE_CLICK=false

# Runtime persistence / service settings
TZ=Asia/Yangon
DATA_DIR=./data
BOT_CONFIG_FILE=bot_config.json
DB_FILE=catch_history.db
