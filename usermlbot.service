[Unit]
Description=Usermlbot Pyrogram Service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple

# Replace these placeholders with the actual VPS account and project paths.
User=REPLACE_WITH_LINUX_USER
Group=REPLACE_WITH_LINUX_GROUP
WorkingDirectory=/REPLACE/WITH/PROJECT/PATH
EnvironmentFile=/REPLACE/WITH/PROJECT/PATH/.env
ExecStart=/REPLACE/WITH/PROJECT/PATH/.venv/bin/python -u /REPLACE/WITH/PROJECT/PATH/main.py

Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=027
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
